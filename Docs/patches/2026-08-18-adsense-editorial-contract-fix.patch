+function stripReaderVisibleSourceSections(
+  blocks: ContentDocument["blocks"],
+): readonly ContentDocument["blocks"][number][] {
+  const result: ContentDocument["blocks"][number][] = [];
+  let sourceLevel: number | undefined;
+  for (const block of blocks) {
+    if (block.type === "heading") {
+      const heading = block.text.trim().replace(/\s+/g, " ");
+      if (heading === "출처") {
+        sourceLevel = block.level;
+        continue;
+      }
+      if (sourceLevel !== undefined && block.level <= sourceLevel) sourceLevel = undefined;
+    }
+    if (sourceLevel !== undefined) continue;
+    result.push(block);
+  }
+  return Object.freeze(result);
+}
