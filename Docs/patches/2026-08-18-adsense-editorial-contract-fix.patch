 function headingContainsAnyTerm(heading: string, terms: readonly string[]): boolean {
   const normalizedHeading = normalize(heading);
   return terms.some((term) => normalizedHeading.includes(normalize(term)));
 }
+
+function isSystemEditorialHeading(value: string): boolean {
+  const heading = normalize(value).replace(/\s+/g, " ").trim();
+  return heading === normalize("출처")
+    || heading === normalize("정보 기준과 다시 확인할 곳");
+}
